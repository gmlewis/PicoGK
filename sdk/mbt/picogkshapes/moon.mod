// picogkshapes: Higher-level shape construction helpers for PicoGK.
// Provides convenient functions for building common 3D geometry patterns.

name = "gmlewis/picogkshapes"

version = "0.1.0"

repository = "https://github.com/gmlewis/PicoGK"

license = "Apache-2.0"

keywords = [ "geometry", "shapes", "cad" ]

description = "Higher-level shape construction helpers for the PicoGK geometry kernel"

preferred_target = "native"

supported_targets = "+native"

import {
  "gmlewis/picogkffi@0.1.0",
}
