// picogkffi FFI demo entry — test the native binding including SDF.
// Run:  RUSTFLAGS="-Awarnings" gos run src/main.gos

use picogkffi::{init, version, name, new_sphere, new_voxels, voxels_volume, voxels_to_mesh,
    mesh_vertex_count, mesh_triangle_count, voxels_destroy, mesh_destroy, shutdown,
    voxels_bool_subtract, voxels_shell, total_memory_usage, render_gyroid_sphere, Vec3}

fn main() {
    match init(0.2) {
        Ok(_) => println!("init OK"),
        Err(e) => { eprintln!("init failed: {}", e); return }
    }
    println!("version: {}", version())
    println!("name: {}\n", name())

    // 1) Shelled sphere part
    println("--- Shelled part ---")
    let body = match new_sphere(Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 10.0) {
        Ok(h) => h,
        Err(e) => { eprintln!("new_sphere failed: {}", e); return }
    }
    let hole = match new_sphere(Vec3 { x: 6.0, y: 0.0, z: 0.0 }, 6.0) {
        Ok(h) => h,
        Err(e) => { eprintln!("hole failed: {}", e); return }
    }
    voxels_bool_subtract(body, hole)
    println!("  volume before shell: {:.1}", voxels_volume(body))
    voxels_shell(body, 1.0)
    println!("  volume after shell:  {:.1}", voxels_volume(body))

    let mesh = match voxels_to_mesh(body) {
        Ok(h) => h,
        Err(e) => { eprintln!("voxels_to_mesh failed: {}", e); return }
    }
    println!("  mesh verts: {}, tris: {}", mesh_vertex_count(mesh), mesh_triangle_count(mesh))
    voxels_destroy(body)
    voxels_destroy(hole)
    mesh_destroy(mesh)

    // 2) Gyroid sphere via SDF
    println!("\n--- Gyroid sphere (SDF) ---")
    let tpms = match new_voxels() {
        Ok(h) => h,
        Err(e) => { eprintln!("new_voxels failed: {}", e); return }
    }
    let r = 10.0
    let k = 2.0 * 3.14159265358979 / 6.0
    render_gyroid_sphere(tpms, -r - 2.0, -r - 2.0, -r - 2.0, r + 2.0, r + 2.0, r + 2.0, r, 0.4, k)
    println!("  gyroid sphere volume: {:.1}", voxels_volume(tpms))
    let gyroid_mesh = match voxels_to_mesh(tpms) {
        Ok(h) => h,
        Err(e) => { eprintln!("voxels_to_mesh failed: {}", e); return }
    }
    println!("  gyroid mesh verts: {}, tris: {}", mesh_vertex_count(gyroid_mesh), mesh_triangle_count(gyroid_mesh))
    voxels_destroy(tpms)
    mesh_destroy(gyroid_mesh)

    println!("\nNative memory: {:.1} MB", total_memory_usage() as f64 / 1e6)
    shutdown()
    println!("done!")
}

