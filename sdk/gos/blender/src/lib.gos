// blender: Gossamer SDK for the Blender MCP server.
//
// Launches the Blender MCP server as a subprocess and communicates
// via JSON-RPC over stdio, matching the Go and MoonBit SDKs.
//
// Prerequisites (same as the Go and MoonBit SDKs):
//   - Blender running with the MCP addon enabled and server started
//   - The blender-mcp server installed: pip install blender-mcp

use std::encoding::json
use std::env
use std::errors
use std::process
use std::strings
use std::sync

const VERSION: String = "0.2.0"
const PROTOCOL_VERSION: String = "2024-11-05"

// Default command and args to launch the Blender MCP server.
const DEFAULT_SERVER_BIN: String = "uv"
const DEFAULT_SERVER_DIR: String = "~/Projects/Blender/blender_mcp/mcp/blmcp"

// Client manages a connection to the Blender MCP server via stdio.
//
// Usage:
//   let client = blender::new_client()?
//   defer client.close()
//   let res = client.execute_blender_code("import bpy; result = {'count': len(bpy.data.objects)}")?
pub struct Client {
    child: process::Child,
    msg_id: sync::AtomicI64,
}

// new_client launches the Blender MCP server and returns a Client.
pub fn new_client() -> Result<Client, errors::Error> {
    new_client_with("")
}

// new_client_with lets the caller specify a custom server directory.
pub fn new_client_with(server_dir: String) -> Result<Client, errors::Error> {
    let dir = if server_dir == "" {
        expand_path(DEFAULT_SERVER_DIR)
    } else {
        expand_path(server_dir)
    }
    let args: [String] = [
        "--directory".to_string(),
        dir,
        "run".to_string(),
        "blender-mcp".to_string(),
    ].to_vec()
    let c = Client {
        child: process::spawn_piped(DEFAULT_SERVER_BIN, args)?,
        msg_id: sync::AtomicI64::new(0),
    }
    c.initialize()?
    Ok(c)
}

impl Client {
    pub fn close(&self) {
        self.child.close_stdin()
        self.child.kill()
    }

    fn next_id(&self) -> i64 {
        self.msg_id.fetch_add(1) + 1
    }

    fn initialize(&self) -> Result<(), errors::Error> {
        let req = build_rpc_request(self.next_id(), "initialize", init_params())
        let _ = self.call_raw(req)?
        let notif = json::Value::object([
            ("jsonrpc", json::Value::String("2.0")),
            ("method", json::Value::String("notifications/initialized")),
        ])
        self.child.write_stdin(json::render(notif) + "\n")
        Ok(())
    }

    fn call_raw(&self, req: json::Value) -> Result<json::Value, errors::Error> {
        self.child.write_stdin(json::render(req) + "\n")
        match self.child.read_line() {
            Some(line) => {
                let line = strings::trim(line)
                match json::parse(line) {
                    Ok(v) => {
                        if let Some(err) = json::get(&v, "error") {
                            let mut code: i64 = 0
                            if let Some(cv) = json::get(err, "code") {
                                if let Some(n) = json::as_i64(cv) { code = n }
                            }
                            let mut msg = "unknown error"
                            if let Some(mv) = json::get(err, "message") {
                                if let Some(s) = json::as_str(mv) { msg = s }
                            }
                            return Err(errors::newf("server error [{}]: {}", code, msg))
                        }
                        Ok(v)
                    },
                    Err(e) => Err(errors::newf("json parse: {}", e)),
                }
            },
            None => Err(errors::new("server closed stdout")),
        }
    }

    pub fn call_tool(&self, tool_name: String, args: json::Value) -> Result<String, errors::Error> {
        let params = json::Value::object([
            ("name", json::Value::String(tool_name)),
            ("arguments", args),
        ])
        let req = build_rpc_request(self.next_id(), "tools/call", params)
        let result = self.call_raw(req)?
        let res_obj = match json::get(&result, "result") {
            Some(v) => v,
            None => return Err(errors::new("missing result field")),
        }
        let content = match json::get(res_obj, "content") {
            Some(v) => v,
            None => return Err(errors::new("missing content field")),
        }
        let items = match json::as_array(content) {
            Some(a) => a,
            None => return Err(errors::new("content is not an array")),
        }
        let mut text = ""
        for item in items {
            if let Some(t) = json::get(item, "type") {
                if json::as_str(t) == Some("text") {
                    if let Some(txt) = json::get(item, "text") {
                        if let Some(s) = json::as_str(txt) {
                            text += s
                        }
                    }
                }
            }
        }
        let mut is_error = false
        if let Some(v) = json::get(res_obj, "isError") {
            if let Some(b) = json::as_bool(v) { is_error = b }
        }
        if is_error {
            return Err(errors::newf("tool error: {}", text))
        }
        Ok(text)
    }
}

fn build_rpc_request(id: i64, method: String, params: json::Value) -> json::Value {
    json::Value::object([
        ("jsonrpc", json::Value::String("2.0")),
        ("id", json::Value::Int(id)),
        ("method", json::Value::String(method)),
        ("params", params),
    ])
}

fn init_params() -> json::Value {
    json::Value::object([
        ("protocolVersion", json::Value::String(PROTOCOL_VERSION)),
        ("capabilities", json::Value::object([])),
        ("clientInfo", json::Value::object([
            ("name", json::Value::String("blender-gos-sdk")),
            ("version", json::Value::String(VERSION)),
        ])),
    ])
}

pub fn expand_path(path: String) -> String {
    if let Some(rest) = strings::strip_prefix(path, "~") {
        let home = env::home_dir().unwrap_or("")
        home + rest
    } else {
        path
    }
}

// === Unit tests ===

#[cfg(test)]
mod blender_tests {
    use std::testing

    #[test]
    fn expand_path_tilde() {
        let p = expand_path("~/foo".to_string())
        testing::check(p.contains("foo"), "tilde should expand, got: {}", p)
    }

    #[test]
    fn expand_path_no_tilde() {
        let p = expand_path("/abs/path".to_string())
        testing::check_eq(p, "/abs/path", "absolute path unchanged")
    }
}
