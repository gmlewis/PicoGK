// picogk: Gossamer SDK for the PicoGK MCP server.
//
// Gossamer cannot pipe stdin/stdout to a long-running subprocess, so
// this SDK batches all JSON-RPC requests into a single pipeline run:
// it writes all requests to a temp file, pipes them through the PicoGK
// MCP server (with a sleep to keep stdin open long enough for the
// server to flush responses), and parses the newline-delimited JSON
// responses.
//
// Prerequisites (same as the Go and MoonBit SDKs):
//   - The PicoGK MCP server binary at ~/.local/bin/picogk-mcp/PicoGK.Mcp

use std::collections::HashMap
use std::encoding::json
use std::env
use std::errors
use std::fs
use std::process
use std::strings
use std::sync

const PROTOCOL_VERSION: String = "2024-11-05"
const DEFAULT_SERVER_BIN: String = "~/.local/bin/picogk-mcp/PicoGK.Mcp"

// Client collects PicoGK MCP tool calls and executes them as a batch.
// Gossamer cannot maintain an interactive subprocess pipe, so all
// requests are sent to the PicoGK server in a single pipeline run.
//
// Usage:
//   let mut client = picogk::new_client()
//   client.picogk_init(Some(0.5))
//   client.create_sphere(0.0, 0.0, 0.0, 30.0, Some("body"))
//   let results = client.execute()?
//   // results[0] = init response, results[1] = sphere response
pub struct Client {
    server_bin: String,
    msg_id: sync::AtomicI64,
    requests: Vec<json::Value>,
}

// new_client returns a Client that will batch-call the PicoGK MCP server.
// Pass "" for the default server binary path.
pub fn new_client() -> Client {
    new_client_with("")
}

pub fn new_client_with(server_bin: String) -> Client {
    let bin = if server_bin == "" {
        expand_path(DEFAULT_SERVER_BIN)
    } else {
        expand_path(server_bin)
    }
    let mut c = Client {
        server_bin: bin,
        msg_id: sync::AtomicI64::new(0),
        requests: Vec::new(),
    }
    c.initialize()
    c
}

impl Client {
    fn next_id(&self) -> i64 {
        self.msg_id.fetch_add(1) + 1
    }

    fn initialize(&mut self) {
        let req = build_rpc_request(self.next_id(), "initialize", init_params())
        self.requests.push(req)
        let notif = json::Value::object([
            ("jsonrpc", json::Value::String("2.0")),
            ("method", json::Value::String("notifications/initialized")),
        ])
        self.requests.push(notif)
    }

    // execute runs all queued tool calls against the PicoGK MCP server
    // in a single pipeline. Returns a map of request-id -> response text.
    pub fn execute(&self) -> Result<HashMap<i64, String>, errors::Error> {
        if self.requests.len() == 0 {
            return Ok(HashMap::new())
        }
        // Build a shell script that sends each request line with a
        // small delay between them, ensuring the .NET MCP server
        // processes them sequentially rather than concurrently.
        let mut script = ""
        for req in self.requests {
            let json_str = json::render(req)
            // Escape single quotes in the JSON for the shell.
            let escaped = strings::replace(json_str, "'", "'\\''")
            script += "echo '" + escaped + "'; sleep 0.1; "
        }
        script += "sleep 10"
        let tmpfile = "/tmp/gos-picogk-script.sh"
        fs::write(tmpfile, script)
            .map_err(|e| errors::newf("writing script file: {}", e))?
        // Run: sh -c "cat tmpfile; sleep 10" | server
        // The sleep keeps stdin open long enough for the .NET MCP
        // server to flush all JSON-RPC responses to stdout.
        let _cmd = "sh " + tmpfile
        let result = process::pipeline_run(&[_cmd, self.server_bin])
            .map_err(|e| errors::newf("pipeline run: {}", e))?
        // Clean up temp file.
        let _ = fs::remove_file(tmpfile)
        // Parse responses: each line that starts with { is a JSON-RPC response.
        let mut results: HashMap<i64, String> = HashMap::new()
        for line in strings::lines(result.stdout) {
            let line = strings::trim(line)
            if line.len() == 0 || !line.starts_with("{") {
                continue
            }
            match json::parse(line) {
                Ok(v) => {
                    let id = match json::get(&v, "id") {
                        Some(id_val) => match json::as_i64(id_val) {
                            Some(n) => n,
                            None => continue,
                        },
                        None => continue,
                    }
                    let res_obj = match json::get(&v, "result") {
                        Some(r) => r,
                        None => continue,
                    }
                    let content = match json::get(res_obj, "content") {
                        Some(c) => c,
                        None => continue,
                    }
                    let items = match json::as_array(content) {
                        Some(a) => a,
                        None => continue,
                    }
                    let mut text = ""
                    for item in items {
                        if let Some(t) = json::get(item, "type") {
                            if json::as_str(t) == Some("text") {
                                if let Some(txt) = json::get(item, "text") {
                                    if let Some(s) = json::as_str(txt) {
                                        text += s
                                    }
                                }
                            }
                        }
                    }
                    let mut is_error = false
                    if let Some(ie) = json::get(res_obj, "isError") {
                        if let Some(b) = json::as_bool(ie) {
                            is_error = b
                        }
                    }
                    if is_error {
                        results.insert(id, "ERROR: " + text)
                    } else {
                        results.insert(id, text)
                    }
                }
                Err(_) => continue,
            }
        }
        Ok(results)
    }

    // call_tool queues a tool call. Returns the request id.
    pub fn call_tool(
        &mut self,
        tool_name: String,
        args: json::Value,
    ) -> i64 {
        let id = self.next_id()
        let params = json::Value::object([
            ("name", json::Value::String(tool_name)),
            ("arguments", args),
        ])
        let req = build_rpc_request(id, "tools/call", params)
        self.requests.push(req)
        id
    }
}

fn build_rpc_request(id: i64, method: String, params: json::Value) -> json::Value {
    json::Value::object([
        ("jsonrpc", json::Value::String("2.0")),
        ("id", json::Value::Int(id)),
        ("method", json::Value::String(method)),
        ("params", params),
    ])
}

fn init_params() -> json::Value {
    json::Value::object([
        ("protocolVersion", json::Value::String(PROTOCOL_VERSION)),
        ("capabilities", json::Value::object([])),
        ("clientInfo", json::Value::object([
            ("name", json::Value::String("picogk-gos-sdk")),
            ("version", json::Value::String("1.0.0")),
        ])),
    ])
}

pub fn expand_path(path: String) -> String {
    if let Some(rest) = strings::strip_prefix(path, "~") {
        let home = env::home_dir().unwrap_or("")
        home + rest
    } else {
        path
    }
}

pub fn resolve_path(path: String) -> String {
    let expanded = expand_path(path)
    if expanded.starts_with("/") {
        expanded
    } else {
        let cwd = env::current_dir().unwrap_or(".".to_string())
        cwd + "/" + expanded
    }
}