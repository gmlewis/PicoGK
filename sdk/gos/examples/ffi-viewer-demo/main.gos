// Viewer demo via the native FFI binding.
//
// The OpenGL Viewer IS implemented in the Rust binding crate (viewer.rs)
// with C-side camera callbacks, matching the MoonBit picogk_viewer.c approach.
// However, a gossamer JIT bug (issue #8) may prevent this from running
// on a fresh runner cache build. If the runner is already cached from
// a previous build, it works.
//
// Run:  RUSTFLAGS="-Awarnings" gos run .

use std::os
use picogkffi::{init, version, shutdown, new_sphere, voxels_bool_subtract,
    voxels_shell, voxels_volume, voxels_destroy,
    new_viewer, viewer_add_voxels, viewer_set_group_material,
    viewer_screenshot, viewer_poll, viewer_request_close, viewer_destroy,
    total_memory_usage, Vec3}

fn main() {
    let outdir = "/tmp/gos-picogkffi-viewer"
    os::mkdir_all(outdir)

    println!("=== Viewer Demo (Gossamer FFI) ===")

    match init(0.2) {
        Ok(_) => (),
        Err(e) => { eprintln!("init: {}", e); return }
    }
    defer shutdown()
    println!("PicoGK {}", version())

    let body = match new_sphere(Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 12.0) {
        Ok(h) => h, Err(e) => { eprintln!("sphere: {}", e); return }
    }
    let bite = match new_sphere(Vec3 { x: 8.0, y: 0.0, z: 0.0 }, 7.0) {
        Ok(h) => h, Err(e) => { eprintln!("bite: {}", e); return }
    }
    voxels_bool_subtract(body, bite)
    voxels_shell(body, 1.5)
    println!("  shelled part volume: {:.1}", voxels_volume(body))

    match new_viewer("PicoGK Viewer Demo (FFI)".to_string(), 1280.0, 960.0, 0.16, 0.16, 0.20, 1.0) {
        Ok(v) => {
            viewer_add_voxels(v, 0, body)
            viewer_set_group_material(v, 0, 0.35, 0.6, 0.9, 1.0, 0.1, 0.5)
            viewer_screenshot(v, outdir + "/viewer_demo.png")
            for _ in 0..15 {
                if !viewer_poll(v) { break }
            }
            viewer_request_close(v)
            viewer_destroy(v)
            println!("  -> {}/viewer_demo.png", outdir)
        },
        Err(e) => println!("  Viewer: {} (no display?)", e)
    }
    voxels_destroy(body)
    println!("  memory: {:.1} MB", total_memory_usage() as f64 / 1e6)
    println!("done.")
}
