// Gallery: 16 parametric shape scenes rendered via the OpenGL Viewer.
// Run:  RUSTFLAGS="-Awarnings" gos run --main-thread --no-jit . [--keep-tga] [--scene NAME]

use std::math
use std::os
use std::env
use picogkffi::{init, version, shutdown, new_lattice, lattice_add_sphere, lattice_add_beam,
    lattice_destroy, voxels_destroy, mesh_destroy, voxels_bool_add, voxels_double_offset,
    new_voxels, render_gyroid, render_gyroid_genus, render_superellipsoid,
    new_viewer, viewer_add_voxels, viewer_add_mesh, viewer_set_group_material,
    viewer_screenshot, viewer_screenshot_keep_tga, viewer_request_close, viewer_destroy,
    render_gyroid_sphere, voxels_from_lattice, voxels_from_mesh, voxels_to_mesh,
    new_mesh, mesh_add_vertex, mesh_add_triangle, mesh_vertex_count, mesh_triangle_count,
    mesh_get_vertex, mesh_get_triangle, Vec3, Triangle}
use shapes::{
    V, new_local_frame, new_local_frame_xyz,
    new_sphere_shape, new_sphere_shape_const, new_box, new_box_mod, new_cylinder, new_cylinder_const,
    new_ring, new_ring_mod, new_lens, with_lower, with_upper, new_pipe, with_frames,
    new_lattice_pipe, with_lattice_pipe_frames, new_lattice_manifold, with_extend_both_sides,
    new_control_point_spline, frames_aligned_to_x,
    surf_mod_fn, line_mod_fn, line_mod_constant, to_voxels,
    new_color_scale_3d, rainbow_spectrum, split_by_overhang_angle,
}

fn line1(lr: f64) -> f64 { 10.0 - 3.0 * math::cos(8.0 * lr) }
fn line2(lr: f64) -> f64 { 8.0 - math::cos(40.0 * lr) }
fn surf1(phi: f64, lr: f64) -> f64 { 12.0 + 3.0 * math::cos(5.0 * phi) }
fn surf3(phi: f64, lr: f64) -> f64 { 8.0 + 5.0 * math::cos(5.0 * phi) }

fn spline_points() -> Vec<Vec3> {
    let ctrl = [V(0.0, 0.0, 0.0), V(0.0, 40.0, 0.0), V(0.0, 50.0, 20.0), V(0.0, 60.0, 60.0)].to_vec()
    new_control_point_spline(ctrl, 2, false).points(500)
}

fn safe_voxels(r: Result<i64, String>) -> i64 {
    match r { Ok(h) => h, Err(e) => { eprintln!("  error: {}", e); 0 } }
}

fn safe_mesh(r: Result<i64, String>) -> i64 {
    match r { Ok(h) => h, Err(e) => { eprintln!("  error: {}", e); 0 } }
}

fn render_scene(name: String, groups: Vec<shapes::SceneGroup>, keep_tga: bool) {
    let outdir = "/tmp/gos-ffi-gallery"
    os::mkdir_all(outdir)
    println!("--- {} ---", name)
    if groups.is_empty() { println!("  (empty)"); return }
    match new_viewer("PicoGK Gallery — " + name, 1280.0, 960.0, 0.16, 0.16, 0.20, 1.0) {
        Ok(v) => {
            let mut i = 0
            while i < groups.len() {
                if groups[i].voxels != 0 { viewer_add_voxels(v, i as i64, groups[i].voxels) }
                if groups[i].mesh != 0 { viewer_add_mesh(v, i as i64, groups[i].mesh) }
                let c = groups[i].color
                viewer_set_group_material(v, i as i64, c.r, c.g, c.b, 1.0, 0.1, 0.5)
                i += 1
            }
            let png_path = outdir + "/" + name + ".png"
            if keep_tga {
                viewer_screenshot_keep_tga(v, png_path)
            } else {
                viewer_screenshot(v, png_path)
            }
            viewer_request_close(v)
            viewer_destroy(v)
            println!("  -> {}", png_path)
        },
        Err(e) => println!("  viewer error: {}", e)
    }
    let mut ci = 0
    while ci < groups.len() {
        if groups[ci].voxels != 0 { voxels_destroy(groups[ci].voxels) }
        if groups[ci].mesh != 0 { mesh_destroy(groups[ci].mesh) }
        ci += 1
    }
}

fn build_box() -> Vec<shapes::SceneGroup> {
    let b1 = safe_voxels(new_box(new_local_frame(V(-50.0, 0.0, 0.0)), 20.0, 10.0, 15.0).to_voxels())
    let b2 = safe_voxels(new_box_mod(new_local_frame(V(50.0, 0.0, 0.0)), 20.0, line_mod_fn(line2), line_mod_fn(line1)).to_voxels())
    let b3 = safe_voxels(new_box_mod(new_local_frame(V(0.0, 0.0, 0.0)), 20.0, line_mod_fn(line2), line_mod_fn(line1)).to_voxels())
    [shapes::SceneGroup { voxels: b1, mesh: 0, color: shapes::COLOR_BLUE },
     shapes::SceneGroup { voxels: b2, mesh: 0, color: shapes::COLOR_GREEN },
     shapes::SceneGroup { voxels: b3, mesh: 0, color: shapes::COLOR_YELLOW }].to_vec()
}

fn build_sphere() -> Vec<shapes::SceneGroup> {
    let s1 = safe_voxels(new_sphere_shape_const(new_local_frame(V(-100.0, 0.0, 0.0)), 40.0).to_voxels())
    let s2 = safe_voxels(new_sphere_shape(new_local_frame(V(0.0, 0.0, 0.0)), surf_mod_fn(|_p, t| 40.0 - 10.0 * math::cos(6.0 * t))).to_voxels())
    let s3 = safe_voxels(new_sphere_shape(new_local_frame(V(150.0, 0.0, 0.0)), surf_mod_fn(|phi, t| 40.0 - 10.0 * math::cos(6.0 * t) + 30.0 * math::cos(2.0 * phi))).to_voxels())
    [shapes::SceneGroup { voxels: s1, mesh: 0, color: shapes::COLOR_FROZEN },
     shapes::SceneGroup { voxels: s2, mesh: 0, color: shapes::COLOR_PITAYA },
     shapes::SceneGroup { voxels: s3, mesh: 0, color: shapes::COLOR_WARNING }].to_vec()
}

fn build_cylinder() -> Vec<shapes::SceneGroup> {
    let c1 = safe_voxels(new_cylinder_const(new_local_frame(V(-50.0, 0.0, 0.0)), 60.0, 40.0).to_voxels())
    let c2 = safe_voxels(new_cylinder(new_local_frame(V(50.0, 0.0, 0.0)), 60.0, surf_mod_fn(|_p, lr| line1(lr))).to_voxels())
    let c3 = safe_voxels(new_cylinder(new_local_frame(V(0.0, 0.0, 0.0)), 60.0, surf_mod_fn(|phi, lr| surf1(phi, lr))).to_voxels())
    [shapes::SceneGroup { voxels: c1, mesh: 0, color: shapes::COLOR_BLUE },
     shapes::SceneGroup { voxels: c2, mesh: 0, color: shapes::COLOR_GREEN },
     shapes::SceneGroup { voxels: c3, mesh: 0, color: shapes::COLOR_YELLOW }].to_vec()
}

fn build_ring() -> Vec<shapes::SceneGroup> {
    let r1 = safe_voxels(new_ring(new_local_frame(V(-50.0, -50.0, 0.0)), 30.0, 8.0).to_voxels())
    let r2 = safe_voxels(new_ring_mod(new_local_frame(V(-50.0, 50.0, 0.0)), 30.0, surf_mod_fn(|phi, _a| 10.0 - 2.0 * math::cos(5.0 * phi))).to_voxels())
    let r3 = safe_voxels(new_ring_mod(new_local_frame(V(50.0, 50.0, 0.0)), 30.0, surf_mod_fn(|_p, alpha| 10.0 + 3.0 * math::cos(5.0 * alpha))).to_voxels())
    let r4 = safe_voxels(new_ring_mod(new_local_frame(V(50.0, -50.0, 0.0)), 30.0, surf_mod_fn(|phi, alpha| 10.0 - 2.0 * math::cos(5.0 * (phi + alpha)) + 3.0 * math::cos(5.0 * alpha))).to_voxels())
    [shapes::SceneGroup { voxels: r1, mesh: 0, color: shapes::COLOR_FROZEN },
     shapes::SceneGroup { voxels: r2, mesh: 0, color: shapes::COLOR_PITAYA },
     shapes::SceneGroup { voxels: r3, mesh: 0, color: shapes::COLOR_WARNING },
     shapes::SceneGroup { voxels: r4, mesh: 0, color: shapes::COLOR_BLUEBERRY }].to_vec()
}

fn build_lens() -> Vec<shapes::SceneGroup> {
    let surf = |phi: f64, rr: f64| 12.0 + 3.0 * math::cos(5.0 * phi)
    let l1 = safe_voxels(new_lens(new_local_frame(V(-50.0, -50.0, 0.0)), 10.0, 10.0, 40.0).to_voxels())
    let l2 = safe_voxels(with_lower(with_upper(new_lens(new_local_frame(V(50.0, 50.0, 0.0)), 10.0, 10.0, 40.0),
        surf_mod_fn(|phi, rr| 5.0 - surf(phi, rr))),
        surf_mod_fn(|phi, rr| 5.0 + surf(phi, rr))).to_voxels())
    let l3 = safe_voxels(with_lower(with_upper(new_lens(new_local_frame(V(-50.0, 50.0, 0.0)), 10.0, 10.0, 40.0),
        surf_mod_fn(|phi, rr| 5.0 - surf(phi, rr))),
        surf_mod_fn(|phi, rr| 5.0 + math::cos(6.0 * (phi + 0.3 * math::PI * rr)) + 3.0 * math::cos(20.0 * rr))).to_voxels())
    [shapes::SceneGroup { voxels: l1, mesh: 0, color: shapes::COLOR_FROZEN },
     shapes::SceneGroup { voxels: l2, mesh: 0, color: shapes::COLOR_PITAYA },
     shapes::SceneGroup { voxels: l3, mesh: 0, color: shapes::COLOR_WARNING }].to_vec()
}

fn build_pipe() -> Vec<shapes::SceneGroup> {
    let p1 = safe_voxels(new_pipe(new_local_frame(V(-50.0, 0.0, 0.0)), 60.0, 10.0, 20.0).to_voxels())
    let p2 = safe_voxels(new_pipe(new_local_frame(V(0.0, 0.0, 0.0)), 60.0, 10.0, 20.0).to_voxels())
    let p3 = safe_voxels(new_pipe(new_local_frame(V(50.0, -50.0, 0.0)), 60.0, 6.0, line_mod_fn(line1)).to_voxels())
    let spine = frames_aligned_to_x(spline_points(), V(0.0, 1.0, 0.0))
    let p4 = safe_voxels(with_frames(new_pipe(new_local_frame(V(0.0, 0.0, 0.0)), 60.0, 6.0, 6.0), spine).to_voxels())
    [shapes::SceneGroup { voxels: p1, mesh: 0, color: shapes::COLOR_BLUE },
     shapes::SceneGroup { voxels: p2, mesh: 0, color: shapes::COLOR_GREEN },
     shapes::SceneGroup { voxels: p3, mesh: 0, color: shapes::COLOR_LEMONGRASS },
     shapes::SceneGroup { voxels: p4, mesh: 0, color: shapes::COLOR_ORCHID }].to_vec()
}

fn build_basic_lattices() -> Vec<shapes::SceneGroup> {
    let lat = match new_lattice() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    lattice_add_sphere(lat, V(1.0, 5.0, -10.0), 5.0)
    lattice_add_beam(lat, V(5.0, 3.0, 0.0), V(-3.0, 0.0, 7.0), 1.0, 3.0, true)
    let v = safe_voxels(voxels_from_lattice(lat))
    lattice_destroy(lat)
    [shapes::SceneGroup { voxels: v, mesh: 0, color: shapes::COLOR_BLUEBERRY }].to_vec()
}

fn build_lattice_pipe() -> Vec<shapes::SceneGroup> {
    let lp1 = safe_voxels(new_lattice_pipe(new_local_frame(V(-50.0, 0.0, 0.0)), 60.0, 10.0).to_voxels())
    let lp2 = safe_voxels(new_lattice_pipe_mod(new_local_frame(V(50.0, -50.0, 0.0)), 60.0, line_mod_fn(line1)).to_voxels())
    let spine = frames_aligned_to_x(spline_points(), V(0.0, 1.0, 0.0))
    let lp3 = safe_voxels(with_lattice_pipe_frames(new_lattice_pipe(new_local_frame(V(0.0, 0.0, 0.0)), 60.0, line_mod_fn(line1)), spine).to_voxels())
    [shapes::SceneGroup { voxels: lp1, mesh: 0, color: shapes::COLOR_YELLOW },
     shapes::SceneGroup { voxels: lp2, mesh: 0, color: shapes::COLOR_FROZEN },
     shapes::SceneGroup { voxels: lp3, mesh: 0, color: shapes::COLOR_RACINGGREEN }].to_vec()
}

fn build_lattice_manifold() -> Vec<shapes::SceneGroup> {
    let lm1 = safe_voxels(new_lattice_manifold(new_local_frame_xyz(V(-50.0, 0.0, 0.0), V(0.0, 1.0, 0.0), V(1.0, 0.0, 0.0)), 50.0, 5.0, 45.0).to_voxels())
    let lm2 = safe_voxels(with_extend_both_sides(new_lattice_manifold(new_local_frame_xyz(V(0.0, 0.0, 0.0), V(0.0, 1.0, 0.0), V(1.0, 0.0, 0.0)), 50.0, 10.0, 30.0), true).to_voxels())
    let lm3 = safe_voxels(with_extend_both_sides(new_lattice_manifold(new_local_frame_xyz(V(50.0, 0.0, 0.0), V(0.0, 1.0, 0.0), V(1.0, 0.0, 0.0)), 50.0, 5.0, 60.0), true).to_voxels())
    [shapes::SceneGroup { voxels: lm1, mesh: 0, color: shapes::COLOR_YELLOW },
     shapes::SceneGroup { voxels: lm2, mesh: 0, color: shapes::COLOR_CRYSTAL },
     shapes::SceneGroup { voxels: lm3, mesh: 0, color: shapes::COLOR_GREEN }].to_vec()
}

fn build_gyroid_sphere() -> Vec<shapes::SceneGroup> {
    let v = match new_voxels() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    let r = 10.0
    let k = 2.0 * math::PI / 3.0
    let wall = 0.5
    render_gyroid_sphere(v, -r - 2.0, -r - 2.0, -r - 2.0, r + 2.0, r + 2.0, r + 2.0, r, wall, k)
    [shapes::SceneGroup { voxels: v, mesh: 0, color: shapes::COLOR_BILLIE }].to_vec()
}

fn build_gyroid_genus() -> Vec<shapes::SceneGroup> {
    let v = match new_voxels() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    let s = 8.0
    render_gyroid_genus(v, -3.0 * s, -3.0 * s, -1.6 * s, 3.0 * s, 3.0 * s, 1.6 * s, s, 0.0, 2.0 * math::PI / 6.0)
    [shapes::SceneGroup { voxels: v, mesh: 0, color: shapes::COLOR_LAVENDER }].to_vec()
}

fn build_superellipsoid() -> Vec<shapes::SceneGroup> {
    let a = 16.0
    let v1 = match new_voxels() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    render_superellipsoid(v1, -a, -a, -a, a, a, a, a, a, a, 3.0, 0.25)
    let v2 = match new_voxels() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    render_superellipsoid(v2, -a, -a, -a, a, a, a, a, a, a, 1.5, 1.5)
    let v3 = match new_voxels() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    render_superellipsoid(v3, -a, -a, -a, a, a, a, a, a, a, 0.25, 0.25)
    // Translate each to its centre via mesh round-trip
    let g1 = translate_voxels(v1, V(-45.0, 0.0, 0.0), shapes::COLOR_RUBY)
    let g2 = translate_voxels(v2, V(0.0, 0.0, 0.0), shapes::COLOR_BLUE)
    let g3 = translate_voxels(v3, V(45.0, 0.0, 0.0), shapes::COLOR_BUBBLEGUM)
    [g1, g2, g3].to_vec()
}

fn translate_voxels(v: i64, centre: Vec3, color: shapes::RGB) -> shapes::SceneGroup {
    let mesh = safe_mesh(voxels_to_mesh(v))
    voxels_destroy(v)
    let nv = mesh_vertex_count(mesh)
    let mut i = 0
    while i < nv {
        let p = mesh_get_vertex(mesh, i)
        let _ = mesh_add_vertex(mesh, V(p.x + centre.x, p.y + centre.y, p.z + centre.z))
        i += 1
    }
    // Now build a new mesh with translated vertices by round-tripping through arrays
    // Actually, the Go approach reads all vertices and triangles, translates, creates new mesh
    let nt = mesh_triangle_count(mesh)
    let mut verts: Vec<f32> = [].to_vec()
    let mut tris: Vec<i32> = [].to_vec()
    let mut ti = 0
    while ti < nt {
        let t = mesh_get_triangle(mesh, ti)
        tris.push(t.a as i32)
        tris.push(t.b as i32)
        tris.push(t.c as i32)
        ti += 1
    }
    let mut vi = 0
    while vi < nv {
        let p = mesh_get_vertex(mesh, vi)
        verts.push((p.x + centre.x) as f32)
        verts.push((p.y + centre.y) as f32)
        verts.push((p.z + centre.z) as f32)
        vi += 1
    }
    mesh_destroy(mesh)
    let new_mesh = safe_mesh(new_mesh())
    let mut idx_map: Vec<i64> = [].to_vec()
    let mut k = 0
    while k < verts.len() {
        let _ = mesh_add_vertex(new_mesh, V(verts[k] as f64, verts[k + 1] as f64, verts[k + 2] as f64))
        idx_map.push((k / 3) as i64)
        k += 3
    }
    let mut tj = 0
    while tj < tris.len() {
        let _ = mesh_add_triangle(new_mesh, idx_map[tris[tj] as i64], idx_map[tris[tj + 1] as i64], idx_map[tris[tj + 2] as i64])
        tj += 3
    }
    let new_vox = safe_voxels(voxels_from_mesh(new_mesh))
    mesh_destroy(new_mesh)
    shapes::SceneGroup { voxels: new_vox, mesh: 0, color }
}

fn build_mesh_painter() -> Vec<shapes::SceneGroup> {
    let ball = new_sphere_shape_const(new_local_frame(V(0.0, 0.0, 0.0)), 40.0)
    let mesh = match ball.to_mesh() { Ok(h) => h, Err(e) => { eprintln!("{}", e); return [].to_vec() } }
    let scale = new_color_scale_3d(rainbow_spectrum(), 0.0, 90.0)
    split_by_overhang_angle(mesh, scale, 50)
}

fn build_mesh_trafo() -> Vec<shapes::SceneGroup> {
    let box1 = safe_voxels(new_box(new_local_frame(V(0.0, 0.0, 0.0)), 40.0, 30.0, 20.0).to_voxels())
    let mesh = safe_mesh(voxels_to_mesh(box1))
    voxels_destroy(box1)
    let nv = mesh_vertex_count(mesh)
    let nt = mesh_triangle_count(mesh)
    let mut verts: Vec<f32> = [].to_vec()
    let mut tris: Vec<i32> = [].to_vec()
    let mut ti = 0
    while ti < nt {
        let t = mesh_get_triangle(mesh, ti)
        tris.push(t.a as i32)
        tris.push(t.b as i32)
        tris.push(t.c as i32)
        ti += 1
    }
    let c = math::cos(math::PI / 4.0)
    let s = math::sin(math::PI / 4.0)
    let mut vi = 0
    while vi < nv {
        let p = mesh_get_vertex(mesh, vi)
        let x = p.x as f32
        let y = p.y as f32
        verts.push((c * x - s * y) as f32)
        verts.push((s * x + c * y) as f32)
        verts.push(p.z as f32)
        vi += 1
    }
    mesh_destroy(mesh)
    let rot_mesh = safe_mesh(new_mesh())
    let mut k = 0
    while k < verts.len() {
        let _ = mesh_add_vertex(rot_mesh, V(verts[k] as f64, verts[k + 1] as f64, verts[k + 2] as f64))
        k += 3
    }
    let mut tj = 0
    while tj < tris.len() {
        let _ = mesh_add_triangle(rot_mesh, tris[tj] as i64, tris[tj + 1] as i64, tris[tj + 2] as i64)
        tj += 3
    }
    let rot_vox = safe_voxels(voxels_from_mesh(rot_mesh))
    mesh_destroy(rot_mesh)
    let original_box = safe_voxels(new_box(new_local_frame(V(0.0, 0.0, 0.0)), 40.0, 30.0, 20.0).to_voxels())
    [shapes::SceneGroup { voxels: original_box, mesh: 0, color: shapes::COLOR_GRAY },
     shapes::SceneGroup { voxels: rot_vox, mesh: 0, color: shapes::COLOR_ORCHID }].to_vec()
}

fn build_over_offset() -> Vec<shapes::SceneGroup> {
    let b1 = safe_voxels(new_box(new_local_frame(V(-15.0, 0.0, 0.0)), 30.0, 30.0, 30.0).to_voxels())
    let b2 = safe_voxels(new_box(new_local_frame(V(15.0, 0.0, 0.0)), 30.0, 30.0, 30.0).to_voxels())
    if b1 != 0 && b2 != 0 {
        voxels_bool_add(b1, b2)
        voxels_destroy(b2)
        voxels_double_offset(b1, 4.0, -4.0)
        return [shapes::SceneGroup { voxels: b1, mesh: 0, color: shapes::COLOR_BUBBLEGUM }].to_vec()
    }
    [].to_vec()
}

fn main() {
    let outdir = "/tmp/gos-ffi-gallery"
    os::mkdir_all(outdir)
    let args = env::args()
    let mut keep_tga = false
    let mut scene_only = ""
    for arg in args {
        if arg == "--keep-tga" || arg == "-keep-tga" {
            keep_tga = true
        }
        if arg == "--scene" || arg == "-scene" {
            scene_only = ""
        }
        if scene_only == "" && (arg == "--scene" || arg == "-scene") {
            scene_only = ""
        }
    }
    // Simple arg parse: look for -scene NAME
    let mut i = 0
    let argv = env::args()
    let mut found_scene_flag = false
    for a in argv {
        if found_scene_flag {
            scene_only = a
            found_scene_flag = false
        } else if a == "--scene" || a == "-scene" {
            found_scene_flag = true
        } else if a == "--keep-tga" || a == "-keep-tga" {
            keep_tga = true
        }
    }
    println!("=== FFI Gallery (Gossamer) ===")
    println!("Output dir: {}", outdir)
    match init(0.2) { Ok(_) => (), Err(e) => { eprintln!("init: {}", e); return } }
    defer shutdown()
    println!("PicoGK {}", version())

    let scenes: Vec<(String, Fn() -> Vec<shapes::SceneGroup>)> = [
        ("box".to_string(), || build_box()),
        ("sphere".to_string(), || build_sphere()),
        ("cylinder".to_string(), || build_cylinder()),
        ("ring".to_string(), || build_ring()),
        ("lens".to_string(), || build_lens()),
        ("pipe".to_string(), || build_pipe()),
        ("basic_lattices".to_string(), || build_basic_lattices()),
        ("lattice_pipe".to_string(), || build_lattice_pipe()),
        ("lattice_manifold".to_string(), || build_lattice_manifold()),
        ("gyroid_sphere".to_string(), || build_gyroid_sphere()),
        ("gyroid_genus".to_string(), || build_gyroid_genus()),
        ("superellipsoid".to_string(), || build_superellipsoid()),
        ("mesh_painter".to_string(), || build_mesh_painter()),
        ("mesh_trafo".to_string(), || build_mesh_trafo()),
        ("over_offset".to_string(), || build_over_offset()),
    ].to_vec()

    for scene in scenes {
        if scene_only != "" && scene.0 != scene_only {
            continue
        }
        let groups = scene.1()
        render_scene(scene.0, groups, keep_tga)
    }
    println!("\ndone.")
}