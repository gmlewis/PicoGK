// Gallery stub — requires the OpenGL Viewer + picogkshapes library.
//
// The Go FFI gallery renders 16 parametric shape scenes (box, sphere,
// cylinder, ring, lens, pipe, lattice pipe, lattice manifold, gyroid sphere,
// gyroid genus, superellipsoid, mesh painter, mesh transform, over-offset,
// etc.) using the picogkshapes shape library and the native OpenGL Viewer.
//
// Neither picogkshapes nor the OpenGL Viewer is available via the Gossamer
// FFI binding:
//   - picogkshapes is a Go-native package with no Gossamer FFI counterpart.
//   - The Viewer requires C function-pointer callbacks (see ffi-viewer-demo).
//
// See ffi-hello-picogk for a working headless FFI example that builds
// geometry with the low-level FFI primitives and exports STL.
//
// Run:  gos run .

use picogkffi::{init, version, shutdown}

fn main() {
    println!("=== Gallery (Gossamer FFI) ===")
    println!()
    println!("This example is a stub: it requires the picogkshapes parametric")
    println!("shape library and the OpenGL Viewer, neither of which is")
    println!("available via the Gossamer FFI binding.")
    println!()
    println!("The gallery renders 16 parametric shape scenes using")
    println!("picogkshapes (Box, Sphere, Cylinder, Ring, Lens, Pipe,")
    println!("LatticePipe, LatticeManifold, ImplicitGyroid, ImplicitGenus,")
    println!("ImplicitSuperEllipsoid, etc.) — a Go-native library with no")
    println!("Gossamer FFI counterpart.")
    println!()
    println!("The OpenGL Viewer requires C function-pointer callbacks that")
    println!("cannot be provided from .gos source (see ffi-viewer-demo for details).")
    println!()
    println!("For a working headless FFI example, see ffi-hello-picogk which")
    println!("builds a shelled sphere part and a lattice cage using the")
    println!("low-level FFI primitives and exports STL.")

    match init(0.2) {
        Ok(_) => println!("\nPicoGK {}", version()),
        Err(e) => { eprintln!("init failed: {}", e); return }
    }
    shutdown()
    println!("done.")
}
