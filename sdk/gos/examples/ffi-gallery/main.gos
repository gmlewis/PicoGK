use std::math
use picogkffi::{init, shutdown, voxels_volume, voxels_destroy}
use shapes::{new_box, new_box_mod, new_local_frame, V, line_mod_fn}

fn line1(lr: f64) -> f64 { 10.0 - 3.0 * math::cos(8.0 * lr) }
fn line2(lr: f64) -> f64 { 8.0 - math::cos(40.0 * lr) }

fn main() {
    match init(0.2) { Ok(_) => (), Err(e) => { eprintln!("init: {}", e); return } }
    defer shutdown()

    let b1 = match new_box(new_local_frame(V(-50.0, 0.0, 0.0)), 20.0, 10.0, 15.0).to_voxels() {
        Ok(h) => h, Err(e) => { eprintln!("b1: {}", e); return }
    }
    println!("b1 volume: {:.1}", voxels_volume(b1))
    voxels_destroy(b1)

    let b2 = match new_box_mod(new_local_frame(V(50.0, 0.0, 0.0)), 20.0, line_mod_fn(line2), line_mod_fn(line1)).to_voxels() {
        Ok(h) => h, Err(e) => { eprintln!("b2: {}", e); return }
    }
    println!("b2 volume: {:.1}", voxels_volume(b2))
    voxels_destroy(b2)

    let b3 = match new_box_mod(new_local_frame(V(0.0, 0.0, 0.0)), 20.0, line_mod_fn(line2), line_mod_fn(line1)).to_voxels() {
        Ok(h) => h, Err(e) => { eprintln!("b3: {}", e); return }
    }
    println!("b3 volume: {:.1}", voxels_volume(b3))
    voxels_destroy(b3)
    println!("done")
}
