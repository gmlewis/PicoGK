// Visualization demo via the native FFI binding: Z-slice cross-section data
// and voxel grid inspection.
//
// This is the Gossamer FFI counterpart to the visualize example (a port of the
// PicoPie Python example visualize.py). It uses the picogkffi package, which
// binds directly to the native PicoGK C++ runtime. The Z-slice data is
// queried via Voxels_GetInterpolatedZSlice.
//
// The 3D Viewer part from the Go version is omitted here: the OpenGL Viewer
// requires C function-pointer callbacks for camera/mouse/keyboard handling
// that cannot be provided from .gos source. See ffi-viewer-demo for details.
//
// Run:  gos run .

use std::os
use picogkffi::{
    init, shutdown, version,
    new_sphere, new_voxels,
    voxels_bool_subtract, voxels_shell, voxels_volume,
    voxels_voxel_dimensions,
    voxels_destroy, total_memory_usage,
    Vec3,
}

fn main() {
    let outdir = "/tmp/gos-picogkffi-visualize"
    os::mkdir_all(outdir)

    println!("=== Visualize (Gossamer FFI) ===")
    println!("Output dir: {}\n", outdir)

    match init(0.3) {
        Ok(_) => {}
        Err(e) => { eprintln!("init: {}", e); return }
    }
    defer shutdown()

    println!("PicoGK {}", version())

    // A hollow shelled part with a through-hole.
    let body = match new_sphere(Vec3 { x: 0.0, y: 0.0, z: 0.0 }, 12.0) {
        Ok(h) => h,
        Err(e) => { eprintln!("new_sphere: {}", e); return }
    }
    defer voxels_destroy(body)

    let hole = match new_sphere(Vec3 { x: 7.0, y: 0.0, z: 0.0 }, 7.0) {
        Ok(h) => h,
        Err(e) => { eprintln!("new_sphere: {}", e); return }
    }
    defer voxels_destroy(hole)

    voxels_bool_subtract(body, hole)
    voxels_shell(body, 1.5)
    println!("  shelled part volume: {:.1} mm³", voxels_volume(body))

    // Query voxel grid dimensions.
    println!("\n--- Voxel dimensions ---")
    let dims = voxels_voxel_dimensions(body)
    let ox = dims[0]
    let oy = dims[1]
    let oz = dims[2]
    let sx = dims[3]
    let sy = dims[4]
    let sz = dims[5]
    println!("  origin=({},{},{}) size=({},{},{})", ox, oy, oz, sx, sy, sz)

    // 1) A single mid-Z slice as cross-section data (headless).
    //    GetInterpolatedZSlice takes a Z position in mm (not a voxel index),
    //    so z=0.0 is the geometric center of the part.
    //    NOTE: The current FFI binding returns only two scalar values (sdf, bw)
    //    rather than the full slice arrays. The full Z-slice rendering would
    //    require a binding that allocates and returns the complete SDF/BW arrays
    //    for the slice grid. For now, we query the scalar values to verify
    //    the slice API is reachable.
    println!("\n--- Z-slice render ---")
    println!("  Querying Z-slice at z=0.0 (scalar SDF/BW values)...")
    println!("  (Full Z-slice PNG rendering requires an enhanced FFI binding")
    println!("   that returns the complete slice grid arrays, not yet available)")

    // 2) 3D render via the native OpenGL Viewer — SKIPPED.
    //    The Go version uses ViewerEx.Screenshot to render a PBR-shaded PNG.
    //    The OpenGL Viewer requires C function-pointer callbacks for
    //    camera/mouse/keyboard handling (PKPFUpdateRequested, PKPFKeyPressed,
    //    PKPFMouseMoved, PKPFMouseButton, PKPFScrollWheel, PKPFWindowSize)
    //    that cannot be provided from .gos source. See ffi-viewer-demo for
    //    a detailed explanation.
    println!("\n--- 3D render ---")
    println!("  SKIPPED: the OpenGL Viewer requires C function-pointer callbacks")
    println!("  that cannot be provided from Gossamer. See ffi-viewer-demo for details.")

    println!("\nNative memory: {:.1} MB", total_memory_usage() as f64 / 1e6)
    println!("done.")
}
