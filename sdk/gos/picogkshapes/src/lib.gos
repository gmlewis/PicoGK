pub const COLOR_GREEN: RGB = RGB { r: 0.000000, g: 0.721569, b: 0.000000 }
pub const COLOR_YELLOW: RGB = RGB { r: 0.988235, g: 0.847059, b: 0.031373 }
pub const COLOR_GRAY: RGB = RGB { r: 0.741176, g: 0.741176, b: 0.741176 }
pub const COLOR_BLUEBERRY: RGB = RGB { r: 0.309804, g: 0.050980, b: 0.749020 }
