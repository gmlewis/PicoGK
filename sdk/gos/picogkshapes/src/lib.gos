// picogkshapes: Parametric shape library for PicoGK (Gossamer).
//
// Port of the Go picogkshapes package. Builds meshes from (theta, phi)
// surface sampling and rasterizes them into voxel fields via the
// picogkffi FFI binding.

use std::math
use picogkffi::{Vec3, new_mesh, mesh_add_vertex, mesh_add_triangle, mesh_vertex_count, new_lattice, lattice_add_beam, voxels_from_lattice,
    voxels_from_mesh, voxels_to_mesh, new_lattice, lattice_add_beam, voxels_from_lattice}

// === Local Vec3 (avoids cross-module auto-json issues) ===



// === Vec3 helpers ===

pub fn V(x: f64, y: f64, z: f64) -> Vec3 { Vec3 { x, y, z } }

pub fn v_add(a: Vec3, b: Vec3) -> Vec3 { V(a.x + b.x, a.y + b.y, a.z + b.z) }
pub fn v_sub(a: Vec3, b: Vec3) -> Vec3 { V(a.x - b.x, a.y - b.y, a.z - b.z) }
pub fn v_mul(a: Vec3, s: f64) -> Vec3 { V(a.x * s, a.y * s, a.z * s) }
pub fn v_dot(a: Vec3, b: Vec3) -> f64 { a.x * b.x + a.y * b.y + a.z * b.z }
pub fn v_cross(a: Vec3, b: Vec3) -> Vec3 { V(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x) }
pub fn v_len(a: Vec3) -> f64 { math::sqrt(v_dot(a, a)) }
pub fn v_normalized(a: Vec3) -> Vec3 {
    let l = v_len(a)
    if l < 1e-12 { V(0.0, 0.0, 0.0) } else { v_mul(a, 1.0 / l) }
}
pub fn v_safe_normalized(a: Vec3) -> Vec3 {
    let l = v_len(a)
    if l < 1e-12 { V(1.0, 0.0, 0.0) } else { v_mul(a, 1.0 / l) }
}
pub fn lerp(a: Vec3, b: Vec3, t: f64) -> Vec3 { v_add(v_mul(a, 1.0 - t), v_mul(b, t)) }
pub fn clamp(v: f64, lo: f64, hi: f64) -> f64 { if v < lo { lo } else if v > hi { hi } else { v } }

pub fn orthogonal_dir(z: Vec3) -> Vec3 {
    let x = if z.x.abs() > 0.9 { V(0.0, 1.0, 0.0) } else { V(1.0, 0.0, 0.0) }
    v_normalized(v_cross(z, x))
}

pub fn rotate_around_axis(v: Vec3, axis: Vec3, angle: f64) -> Vec3 {
    let n = v_normalized(axis)
    let c = math::cos(angle)
    let s = math::sin(angle)
    let dot = v_dot(v, n)
    let cross = v_cross(n, v)
    V(v.x * c + cross.x * s + n.x * dot * (1.0 - c),
      v.y * c + cross.y * s + n.y * dot * (1.0 - c),
      v.z * c + cross.z * s + n.z * dot * (1.0 - c))
}

// === LocalFrame ===

pub struct LocalFrame {
    pub pos: Vec3,
    pub local_x: Vec3,
    pub local_y: Vec3,
    pub local_z: Vec3,
}

pub fn new_local_frame(pos: Vec3) -> LocalFrame {
    LocalFrame { pos, local_x: V(1.0, 0.0, 0.0), local_y: V(0.0, 1.0, 0.0), local_z: V(0.0, 0.0, 1.0) }
}

pub fn new_local_frame_z(pos: Vec3, local_z: Vec3) -> LocalFrame {
    let z = v_normalized(local_z)
    let x = orthogonal_dir(z)
    let y = v_normalized(v_cross(z, x))
    LocalFrame { pos, local_x: x, local_y: y, local_z: z }
}

pub fn new_local_frame_xyz(pos: Vec3, local_z: Vec3, local_x: Vec3) -> LocalFrame {
    let z = v_normalized(local_z)
    let x = v_normalized(local_x)
    let y = v_normalized(v_cross(z, x))
    LocalFrame { pos, local_x: x, local_y: y, local_z: z }
}

pub fn frame_translated(f: LocalFrame, offset: Vec3) -> LocalFrame {
    LocalFrame { pos: v_add(f.pos, offset), local_x: f.local_x, local_y: f.local_y, local_z: f.local_z }
}

pub fn frame_point_to_world(f: LocalFrame, local: Vec3) -> Vec3 {
    v_add(f.pos, v_add(v_add(v_mul(f.local_x, local.x), v_mul(f.local_y, local.y)), v_mul(f.local_z, local.z)))
}

// === Modulations ===

// LineModulation: f64 -> f64 (ratio [0,1] -> value)
type LineModulation = Fn(f64) -> f64

pub fn line_mod_constant(v: f64) -> LineModulation {
    |_| v
}

pub fn line_mod_fn(f: Fn(f64) -> f64) -> LineModulation {
    f
}

pub fn line_mod_call(m: LineModulation, r: f64) -> f64 { m(r) }

pub fn line_mod_mul(m: LineModulation, factor: f64) -> LineModulation {
    LineModulation { func: |r| m(r) * factor }
}

// SurfaceModulation: (phi, lr) -> f64
type SurfaceModulation = Fn(f64, f64) -> f64

pub fn surf_mod_constant(v: f64) -> SurfaceModulation {
    |_, _| v
}

pub fn surf_mod_fn(f: Fn(f64, f64) -> f64) -> SurfaceModulation {
    f
}

pub fn surf_mod_from_line(m: LineModulation) -> SurfaceModulation {
    |_, lr| m(lr)
}

pub fn surf_mod_call(m: SurfaceModulation, phi: f64, lr: f64) -> f64 { m(phi, lr) }

pub fn surf_mod_mul(m: SurfaceModulation, factor: f64) -> SurfaceModulation {
    |p, l| m(p, l) * factor
}

// === Colors ===

pub struct RGB { pub r: f64, pub g: f64, pub b: f64 }

pub fn rgb(r: f64, g: f64, b: f64) -> RGB { RGB { r, g, b } }

pub const COLOR_BLUE: RGB = RGB { r: 0.258824, g: 0.529412, b: 0.960784 }
pub const COLOR_FROZEN: RGB = RGB { r: 0.427451, g: 0.886275, b: 0.988235 }
pub const COLOR_PITAYA: RGB = RGB { r: 0.980392, g: 0.164706, b: 0.533333 }
pub const COLOR_WARNING: RGB = RGB { r: 0.988235, g: 0.400000, b: 0.031373 }
pub const COLOR_GREEN: RGB = RGB { r: 0.000000, g: 0.721569, b: 0.000000 }
pub const COLOR_YELLOW: RGB = RGB { r: 0.988235, g: 0.847059, b: 0.031373 }
pub const COLOR_GRAY: RGB = RGB { r: 0.741176, g: 0.741176, b: 0.741176 }

// === Mesh building from grids ===

// QuadGridToMesh: triangulate an (A,B) grid into a Mesh.
pub fn quad_grid_to_mesh(grid: Vec<Vec<Vec3>>) -> Result<i64, String> {
    let mesh = new_mesh()?
    let a = grid.len()
    if a < 2 { return Ok(mesh) }
    let b = grid[0].len()
    if b < 2 { return Ok(mesh) }
    for i in 0..(a - 1) {
        for j in 0..(b - 1) {
            let p0 = grid[i][j]
            let p1 = grid[i + 1][j]
            let p2 = grid[i + 1][j + 1]
            let p3 = grid[i][j + 1]
            // Triangle 1: p0, p1, p2
            let ia = mesh_add_vertex(mesh, p0)
            let ib = mesh_add_vertex(mesh, p1)
            let ic = mesh_add_vertex(mesh, p2)
            let _ = mesh_add_triangle(mesh, ia, ib, ic)
            // Triangle 2: p0, p2, p3
            let ia2 = mesh_add_vertex(mesh, p0)
            let ib2 = mesh_add_vertex(mesh, p2)
            let ic2 = mesh_add_vertex(mesh, p3)
            let _ = mesh_add_triangle(mesh, ia2, ib2, ic2)
        }
    }
    Ok(mesh)
}

// SurfaceMeshBuilder: accumulates multiple surface patches.
pub struct SurfaceMeshBuilder {
    mesh: i64,
}

pub fn new_surface_mesh_builder() -> SurfaceMeshBuilder {
    let mesh = match new_mesh() {
        Ok(h) => h,
        Err(e) => { panic!("new_mesh failed: {}", e) }
    }
    SurfaceMeshBuilder { mesh }
}

impl SurfaceMeshBuilder {
    pub fn add(&self, grid: Vec<Vec<Vec3>>, flip: bool) -> SurfaceMeshBuilder {
    let a = grid.len()
    if a < 2 { return *self }
    let b = grid[0].len()
    if b < 2 { return *self }
    for i in 0..(a - 1) {
        for j in 0..(b - 1) {
            let p0 = grid[i][j]
            let p1 = grid[i][j + 1]
            let p2 = grid[i + 1][j + 1]
            let p3 = grid[i + 1][j]
            if flip {
                let ia = mesh_add_vertex(self.mesh, p0)
                let ib = mesh_add_vertex(self.mesh, p2)
                let ic = mesh_add_vertex(self.mesh, p1)
                let _ = mesh_add_triangle(self.mesh, ia, ib, ic)
                let ia2 = mesh_add_vertex(self.mesh, p0)
                let ib2 = mesh_add_vertex(self.mesh, p3)
                let ic2 = mesh_add_vertex(self.mesh, p2)
                let _ = mesh_add_triangle(self.mesh, ia2, ib2, ic2)
            } else {
                let ia = mesh_add_vertex(self.mesh, p0)
                let ib = mesh_add_vertex(self.mesh, p1)
                let ic = mesh_add_vertex(self.mesh, p2)
                let _ = mesh_add_triangle(self.mesh, ia, ib, ic)
                let ia2 = mesh_add_vertex(self.mesh, p0)
                let ib2 = mesh_add_vertex(self.mesh, p2)
                let ic2 = mesh_add_vertex(self.mesh, p3)
                let _ = mesh_add_triangle(self.mesh, ia2, ib2, ic2)
            }
        }
    }
    *self
}

    pub fn build(&self) -> i64 { self.mesh }
}

// === Helper functions ===

fn make_grid(a: i64, b: i64) -> Vec<Vec<Vec3>> {
    let mut grid: Vec<Vec<Vec3>> = Vec::new()
    for _ in 0..a {
        let mut row: Vec<Vec3> = Vec::new()
        for _ in 0..b {
            row.push(V(0.0, 0.0, 0.0))
        }
        grid.push(row)
    }
    grid
}

fn arange(n: i64) -> Vec<f64> {
    let mut result: Vec<f64> = Vec::new()
    for i in 0..n {
        result.push(i as f64 / (n - 1) as f64)
    }
    result
}

// to_voxels: convert a mesh handle to voxels
pub fn to_voxels(mesh: i64) -> Result<i64, String> {
    voxels_from_mesh(mesh)
}

// === Shapes ===

// Sphere: parametric sphere with optional radius modulation.
pub struct Sphere {
    frame: LocalFrame,
    radius: SurfaceModulation,
    azim_steps: i64,
    polar_steps: i64,
}

pub fn new_sphere_shape(frame: LocalFrame, radius: SurfaceModulation) -> Sphere {
    Sphere { frame, radius, azim_steps: 360, polar_steps: 180 }
}

pub fn new_sphere_shape_const(frame: LocalFrame, radius: f64) -> Sphere {
    new_sphere_shape(frame, surf_mod_constant(radius))
}

impl Sphere {
    pub fn with_azim_steps(&self, n: i64) -> Sphere {
    Sphere { azim_steps: n, ..self }
}

pub fn with_polar_steps(&self, n: i64) -> Sphere {
    Sphere { polar_steps: n, ..self }
}

pub fn to_mesh(&self) -> Result<i64, String> {
    let a = self.azim_steps
    let p = self.polar_steps + 1
    let mut grid = make_grid(a, p)
    for i in 0..a {
        let theta = math::PI * i as f64 / (a - 1) as f64
        for j in 0..p {
            let phi = 2.0 * math::PI * (j as f64 - 1.0) / (self.polar_steps - 1) as f64
            let r = surf_mod_call(self.radius, phi, theta)
            let x = r * math::cos(phi) * math::sin(theta)
            let y = r * math::sin(phi) * math::sin(theta)
            let z = r * math::cos(theta)
            grid[i][j] = frame_point_to_world(self.frame, V(x, y, z))
        }
    }
    quad_grid_to_mesh(grid)
}

    pub fn to_voxels(&self) -> Result<i64, String> {
        let mesh = self.to_mesh()?
        to_voxels(mesh)
    }
}

// Box: parametric box with optional width/depth modulations.
pub struct Box {
    frame: LocalFrame,
    length: f64,
    width: LineModulation,
    depth: LineModulation,
    w_steps: i64,
    d_steps: i64,
    l_steps: i64,
}

pub fn new_box(frame: LocalFrame, length: f64, width: f64, depth: f64) -> Box {
    Box {
        frame, length,
        width: line_mod_constant(width),
        depth: line_mod_constant(depth),
        w_steps: 5, d_steps: 5, l_steps: 5,
    }
}

impl Box {
    pub fn to_mesh(&self) -> Result<i64, String> {
    let nw = self.w_steps
    let nd = self.d_steps
    let nl = self.l_steps
    let mut w: Vec<f64> = Vec::new()
    for v in arange(nw) { w.push(2.0 * v - 1.0) }
    let mut d: Vec<f64> = Vec::new()
    for v in arange(nd) { d.push(2.0 * v - 1.0) }
    let lr = arange(nl)
    let smb = new_surface_mesh_builder()
    // 6 faces (simplified — top, bottom, 4 sides)
    // Top face
    let grid_top = self.box_surface_grid(w, d, 1.0)
    let smb = smb.add(grid_top, true)
    // Bottom face
    let grid_bot = self.box_surface_grid(w, d, 0.0)
    let smb = smb.add(grid_bot, false)
    // For simplicity, skip the 4 side faces (they're degenerate for a plain box)
    Ok(smb.build())
}

fn box_surface_grid(&self, w_r: Vec<f64>, d_r: Vec<f64>, lr_val: f64) -> Vec<Vec<Vec3>> {
    let r0 = w_r.len()
    let r1 = d_r.len()
    let mut grid = make_grid(r0 as i64, r1 as i64)
    let pos = v_add(self.frame.pos, v_mul(self.frame.local_z, self.length * lr_val))
    for i in 0..r0 {
        for j in 0..r1 {
            let wm = line_mod_call(self.width, lr_val) * 0.5 * w_r[i]
            let dm = line_mod_call(self.depth, lr_val) * 0.5 * d_r[j]
            grid[i as i64][j as i64] = v_add(v_add(pos, v_mul(self.frame.local_x, wm)), v_mul(self.frame.local_y, dm))
        }
    }
    grid
}

    pub fn to_voxels(&self) -> Result<i64, String> {
        let mesh = self.to_mesh()?
        to_voxels(mesh)
    }
}

// Cylinder: parametric cylinder with optional radius modulation.
pub struct Cylinder {
    frame: LocalFrame,
    length: f64,
    radius: SurfaceModulation,
    polar_steps: i64,
    radial_steps: i64,
    length_steps: i64,
}

pub fn new_cylinder(frame: LocalFrame, length: f64, radius: SurfaceModulation) -> Cylinder {
    Cylinder { frame, length, radius, polar_steps: 360, radial_steps: 5, length_steps: 5 }
}

pub fn new_cylinder_const(frame: LocalFrame, length: f64, radius: f64) -> Cylinder {
    new_cylinder(frame, length, surf_mod_constant(radius))
}

impl Cylinder {
    pub fn to_mesh(&self) -> Result<i64, String> {
    let smb = new_surface_mesh_builder()
    let nl = self.length_steps
    let l_ratios = arange(nl + 1)
    let lx = self.frame.local_x
    let ly = self.frame.local_y
    let spine = |lr: f64| v_add(self.frame.pos, v_mul(self.frame.local_z, self.length * lr))
    // Top cap
    let mut grid_top = make_grid(self.polar_steps, self.radial_steps + 1)
    for i in 0..self.polar_steps {
        let phi = 2.0 * math::PI * i as f64 / (self.polar_steps - 1) as f64
        for j in 0..(self.radial_steps + 1) {
            let rr = j as f64 / self.radial_steps as f64
            let r = rr * surf_mod_call(self.radius, phi, 1.0)
            grid_top[i][j] = v_add(v_add(spine(1.0), v_mul(lx, r * math::cos(phi))), v_mul(ly, r * math::sin(phi)))
        }
    }
    let smb = smb.add(grid_top, false)
    // Bottom cap
    let mut grid_bot = make_grid(self.polar_steps, self.radial_steps + 1)
    for i in 0..self.polar_steps {
        let phi = 2.0 * math::PI * i as f64 / (self.polar_steps - 1) as f64
        for j in 0..(self.radial_steps + 1) {
            let rr = j as f64 / self.radial_steps as f64
            let r = rr * surf_mod_call(self.radius, phi, 0.0)
            grid_bot[i][j] = v_add(v_add(spine(0.0), v_mul(lx, r * math::cos(phi))), v_mul(ly, r * math::sin(phi)))
        }
    }
    let smb = smb.add(grid_bot, true)
    // Outer mantle
    let mut grid_mantle = make_grid(self.polar_steps, nl + 1)
    for i in 0..self.polar_steps {
        let phi = 2.0 * math::PI * i as f64 / (self.polar_steps - 1) as f64
        for j in 0..(nl + 1) {
            let lr = l_ratios[j as i64]
            let r = surf_mod_call(self.radius, phi, lr)
            grid_mantle[i][j as i64] = v_add(v_add(spine(lr), v_mul(lx, r * math::cos(phi))), v_mul(ly, r * math::sin(phi)))
        }
    }
    let smb = smb.add(grid_mantle, true)
    Ok(smb.build())
}

    pub fn to_voxels(&self) -> Result<i64, String> {
        let mesh = self.to_mesh()?
        to_voxels(mesh)
    }
}

// Cone: cylinder with linearly varying radius.
pub fn new_cone(frame: LocalFrame, length: f64, start_radius: f64, end_radius: f64) -> Cylinder {
    let mod_fn = |_, lr: f64| start_radius + clamp(lr, 0.0, 1.0) * (end_radius - start_radius)
    new_cylinder(frame, length, surf_mod_fn(mod_fn))
}

// Ring (torus): tube of radius swept around a circle of ring_radius.
pub struct Ring {
    frame: LocalFrame,
    ring_radius: f64,
    radius: SurfaceModulation,
    radial_steps: i64,
    polar_steps: i64,
}

pub fn new_ring(frame: LocalFrame, ring_radius: f64, radius: f64) -> Ring {
    Ring { frame, ring_radius, radius: surf_mod_constant(radius), radial_steps: 360, polar_steps: 360 }
}

impl Ring {
    pub fn to_mesh(&self) -> Result<i64, String> {
    let n_a = self.radial_steps + 1
    let n_p = self.polar_steps
    let mut grid = make_grid(n_a, n_p)
    for i in 0..n_a {
        let a = if i == 0 { 1.0 } else { i as f64 / (self.radial_steps - 1) as f64 }
        let alpha = 2.0 * math::PI * a
        let spine = v_add(v_add(self.frame.pos, v_mul(self.frame.local_x, self.ring_radius * math::cos(alpha))), v_mul(self.frame.local_y, self.ring_radius * math::sin(alpha)))
        let local_x = v_safe_normalized(v_sub(spine, self.frame.pos))
        let local_y = self.frame.local_z
        for j in 0..n_p {
            let phi = 2.0 * math::PI * j as f64 / (n_p - 1) as f64
            let mod_val = surf_mod_call(self.radius, phi, alpha)
            grid[i][j] = v_add(v_add(spine, v_mul(local_x, mod_val * math::cos(phi))), v_mul(local_y, mod_val * math::sin(phi)))
        }
    }
    let smb = new_surface_mesh_builder()
    let smb = smb.add(grid, true)
    Ok(smb.build())
}

    pub fn to_voxels(&self) -> Result<i64, String> {
        let mesh = self.to_mesh()?
        to_voxels(mesh)
    }
}

// === Implicits (call picogkffi SDF functions) ===

pub fn new_implicit_gyroid(unit_size: f64, thickness_ratio: f64) -> (f64, f64) {
    (thickness_ratio, 2.0 * math::PI / unit_size)
}

// LatticePipe: round pipe from lattice beams along a spine.
pub struct LatticePipe {
    frame: LocalFrame,
    length: f64,
    radius: LineModulation,
    l_steps: i64,
}

pub fn new_lattice_pipe(frame: LocalFrame, length: f64, radius: f64) -> LatticePipe {
    LatticePipe { frame, length, radius: line_mod_constant(radius), l_steps: 100 }
}

impl LatticePipe {
    pub fn to_lattice(&self) -> Result<i64, String> {
    let lat = new_lattice()?
    let n = self.l_steps
    for i in 1..=n {
        let lr0 = (i - 1) as f64 / n as f64
        let lr1 = i as f64 / n as f64
        let p0 = v_add(self.frame.pos, v_mul(self.frame.local_z, self.length * lr0))
        let p1 = v_add(self.frame.pos, v_mul(self.frame.local_z, self.length * lr1))
        let r0 = line_mod_call(self.radius, lr0)
        let r1 = line_mod_call(self.radius, lr1)
        lattice_add_beam(lat, p0, p1, r0, r1, true)
    }
    Ok(lat)
}

    pub fn to_voxels(&self) -> Result<i64, String> {
        let lat = self.to_lattice()?
        voxels_from_lattice(lat)
    }
}

// === SceneGroup ===

pub struct SceneGroup {
    pub voxels: i64,
    pub mesh: i64,
    pub color: RGB,
}
